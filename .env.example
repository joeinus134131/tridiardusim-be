# Port server backend API
PORT=8080

# Host binding (gunakan 0.0.0.0 agar bisa diakses dari jaringan/docker/dev-server, atau 127.0.0.1 untuk lokal)
HOST=0.0.0.0

# CORS Allowed Origins: URL frontend yang diizinkan mengakses API (pisahkan dengan koma)
# Contoh dev server: ALLOWED_ORIGINS=http://localhost:3000,https://dev.domainanda.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Direktori penyimpanan file sirkuit/project
PROJECT_DIR=data/projects
